# Stripe test mode + RiteStack Supabase. Never commit real keys.
# Copy to .env.local (gitignored). Never point Supabase at Job Pursuit (vhjwzxcgkmxvrmfstzpy).

# Stripe Checkout (test mode only — sk_test_…)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:4317

# Optional. Script scripts/stripe-test-setup.mjs can create these.
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# New RiteStack project only. Anon key is safe for the browser; service_role is not.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_RITESTACK_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Isolation test + Stripe webhook only. Never expose to Next or the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Auth mail (Cloudflare Email Sending → hello@ritestack.app). Never reuse Job Pursuit SMTP/Resend keys.
# SEND_EMAIL_HOOK_SECRET=v1,whsec_
# Optional custom SMTP instead of the hook (smtp.mx.cloudflare.net / user api_token):
# RITESTACK_SMTP_PASS=

# Hosted Playwright + isolation-test.mjs. Reuse these; never the founder inbox.
# RITESTACK_ISO_A_EMAIL=ritestack-iso-a@example.invalid
# RITESTACK_ISO_B_EMAIL=ritestack-iso-b@example.invalid
# RITESTACK_E2E_BASE_URL=https://ritestack.app
