# Paddle (MoR) + optional Stripe test. Never commit real keys. Never paste live secrets into chat.
# Copy to .env.local (gitignored). Never point Supabase at Job Pursuit (vhjwzxcgkmxvrmfstzpy).

# Live $14 is Paddle. Put these on the ritestack Worker after you say “Paddle is ready”:
# wrangler secret put PADDLE_API_KEY
# wrangler secret put PADDLE_WEBHOOK_SECRET
# wrangler secret put PADDLE_PRICE_ID
# wrangler secret put PADDLE_ENV
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=
PADDLE_ENV=sandbox

# Optional local Stripe test Checkout (sk_test_ only). Not live charges.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:4317

# Optional. scripts/stripe-test-setup.mjs can create TEST price + webhook only (refuses sk_live_).
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Founder notify on paid webhook. Leave empty until you set a real inbox.
# Wrangler: wrangler secret put FOUNDERS_PAID_EMAIL  (do not invent an address here)
# FOUNDERS_PAID_EMAIL=

# New RiteStack project only. Anon key is safe for the browser; service_role is not.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_RITESTACK_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Isolation test + billing webhook grant only. Never expose to Next or the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Auth mail (Cloudflare Email Sending → hello@ritestack.app). Never reuse Job Pursuit SMTP/Resend keys.
# SEND_EMAIL_HOOK_SECRET=v1,whsec_
# Optional custom SMTP instead of the hook (smtp.mx.cloudflare.net / user api_token):
# RITESTACK_SMTP_PASS=

# Hosted Playwright + isolation-test.mjs. Reuse these; never the founder inbox.
# RITESTACK_ISO_A_EMAIL=ritestack-iso-a@example.invalid
# RITESTACK_ISO_B_EMAIL=ritestack-iso-b@example.invalid
# RITESTACK_E2E_BASE_URL=https://ritestack.app
