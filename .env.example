# Stripe test mode. Never commit real keys.
# Copy to .env.local (gitignored) or set as Cloudflare Worker secrets.

# Required for Checkout (test mode only — sk_test_…)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:4355

# Optional. Script scripts/stripe-test-setup.mjs can create these.
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# When magic-link auth lands (separate branch). Webhook needs the service role
# to set profiles.pack_paid_at. Never expose the service role to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
