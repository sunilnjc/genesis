{
  "name": "genesis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4317 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --port 4317 --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test src/lib/views.test.ts tests/*.test.ts",
    "stripe:setup": "node --env-file=.env.local scripts/stripe-test-setup.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "isolation": "node scripts/isolation-test.mjs",
    "auth-mail": "node scripts/apply-auth-mail.mjs --templates",
    "e2e:isolation": "playwright test -c e2e/isolation/playwright.config.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@opennextjs/cloudflare": "^1.20.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.57.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.135.0"
  }
}
